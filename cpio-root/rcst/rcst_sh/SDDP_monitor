#!/bin/sh /etc/rc.common

START=90
STOP=90
USE_PROCD=1

zd_version=$(cat /mnt/zd_version)
if [ "$zd_version" = "2" ]; then
	PROG=SDDP_upgrade_2
elif [ "$zd_version" = "3" ]; then
	PROG=SDDP_upgrade
elif [ "$zd_version" = "4" ]; then
	PROG=SDDP_upgrade
fi

start_service() {
	procd_open_instance 600 10 10000
	procd_set_param command /rcst/rcst_app/$PROG
	procd_set_param respawn
	procd_close_instance
}


